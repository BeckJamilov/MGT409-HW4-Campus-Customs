# Copy this file to .env (in this project folder) and fill in your own values.
# Never commit the real .env file.

# Required for the chat assistant: your Portkey API key (OpenAI models are called through Portkey)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: any long random string. Keeps users logged in when the backend restarts.
SESSION_SECRET=replace-with-a-long-random-string

# Optional: model name (default: gpt-5.6-luna)
CHAT_MODEL=gpt-5.6-luna
